# Fill before running: any of gen/run (estimate is local and needs nothing).
# Keep this file git-ignored (already in .gitignore).

# --- OpenRouter (primary, replaces per-vendor keys) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Fallback: direct vendor keys (optional, teacher_trial.py uses these) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Local endpoints (stage 2 base-model probe) ---
OLLAMA_BASE=http://node7.ea.org:11434/v1
HONCHO_BASE=http://node7.ea.org:8000

