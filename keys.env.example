# Fill before running: any of gen/run (estimate is local and needs nothing).
# Keep this file git-ignored (already in .gitignore).

# --- Anthropic direct (PRIMARY for the batch pipeline: batch-run / batch-fetch) ---
# Claude account key (same one the deriver uses). 50% batch rate, no third party.
ANTHROPIC_API_KEY=sk-ant-...
# optional: pin the API version (default 2023-06-01)
# ANTHROPIC_VERSION=2023-06-01

# --- OpenRouter (context generation via DeepSeek, and the round-4 sync run) ---
OPENROUTER_API_KEY=sk-or…...

# --- Local endpoints (stage 2 base-model probe) ---
OLLAMA_BASE=http://node7.ea.org:11434/v1
HONCHO_BASE=http://node7.ea.org:8000

# --- OpenRouter base (default: live; override to mock for tests) ---
# OPENROUTER_BASE=http://127.0.0.1:9933/v1   # mock test server
